# ultra-instinct manifold fixture v1
# An enabled control shares its label with a disabled, hidden, or off-screen twin.
# The penalized twin has the earlier id, so an id tie-break would pick it.
viewport w=1440 h=900
region id=a-disabled role=button label="Export" x=16 y=40 w=80 h=30 actions=click sources=dom flags=disabled
region id=z-export role=button label="Export" x=16 y=40 w=80 h=30 actions=click sources=dom
region id=a-hidden role=button label="Admin" x=16 y=80 w=80 h=30 actions=click sources=dom flags=hidden
region id=z-admin role=button label="Admin" x=16 y=80 w=80 h=30 actions=click sources=dom
region id=a-offscreen role=button label="Undo" x=16 y=1100 w=80 h=30 actions=click sources=dom flags=offscreen
region id=z-undo role=button label="Undo" x=16 y=120 w=80 h=30 actions=click sources=dom
